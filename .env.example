# DEMO_MODE selects demo storage. Leave true until the Neo4j teammate wires live storage.
DEMO_MODE=true
# Switch independently to live for real BAND agents with the current memory store.
BAND_MODE=demo
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Replace before exposing backend beyond localhost. Shared by bridge and backend.
INTERNAL_API_TOKEN=local-demo-change-me
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
BAND_OPPORTUNITY_AGENT_ID=
BAND_OPPORTUNITY_API_KEY=
BAND_REFLECTION_AGENT_ID=
BAND_REFLECTION_API_KEY=
# Optional existing room containing both agents; otherwise a room is created at API startup.
BAND_ROOM_ID=
BAND_REQUEST_TIMEOUT_SECONDS=120
PLAUD_POLL_SECONDS=3
PLAUD_TRANSCRIPT_RETRY_SECONDS=4
PLAUD_TRANSCRIPT_MAX_ATTEMPTS=45
