{
  "BridgeStatusInput": {
    "additionalProperties": false,
    "properties": {
      "status": {
        "enum": [
          "waiting",
          "transcript_waiting",
          "error"
        ],
        "title": "Status",
        "type": "string"
      },
      "message": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Message",
        "type": "string"
      }
    },
    "required": [
      "status",
      "message"
    ],
    "title": "BridgeStatusInput",
    "type": "object"
  },
  "ContextInput": {
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "type": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Type",
        "type": "string"
      },
      "location": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Location",
        "type": "string"
      }
    },
    "required": [
      "title",
      "type",
      "location"
    ],
    "title": "ContextInput",
    "type": "object"
  },
  "Mission": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "skill_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Skill Id",
        "type": "string"
      },
      "context_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Context Id",
        "type": "string"
      },
      "title": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "challenge": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Challenge",
        "type": "string"
      },
      "reason": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Reason",
        "type": "string"
      },
      "confidence": {
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "status": {
        "default": "assigned",
        "enum": [
          "assigned",
          "completed"
        ],
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "id",
      "skill_id",
      "context_id",
      "title",
      "challenge",
      "reason",
      "confidence"
    ],
    "title": "Mission",
    "type": "object"
  },
  "ReflectionResult": {
    "$defs": {
      "Demonstration": {
        "additionalProperties": false,
        "properties": {
          "skill_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Skill Id",
            "type": "string"
          },
          "evidence": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Evidence",
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          }
        },
        "required": [
          "skill_id",
          "evidence",
          "confidence"
        ],
        "title": "Demonstration",
        "type": "object"
      },
      "Gap": {
        "additionalProperties": false,
        "properties": {
          "skill_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Skill Id",
            "type": "string"
          },
          "evidence": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Evidence",
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "name": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "skill_id",
          "evidence",
          "confidence",
          "name"
        ],
        "title": "Gap",
        "type": "object"
      },
      "NextTarget": {
        "additionalProperties": false,
        "properties": {
          "skill_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Skill Id",
            "type": "string"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "skill_id",
          "reason"
        ],
        "title": "NextTarget",
        "type": "object"
      },
      "WordEvidence": {
        "additionalProperties": false,
        "description": "One vocabulary observation from a real-world transcript. word_id must exist in the curriculum.",
        "properties": {
          "word_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Word Id",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "used_correctly",
              "used_incorrectly",
              "not_understood"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "evidence": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Evidence",
            "type": "string"
          }
        },
        "required": [
          "word_id",
          "outcome",
          "evidence"
        ],
        "title": "WordEvidence",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "mission_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Mission Id",
        "type": "string"
      },
      "recording_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Recording Id",
        "type": "string"
      },
      "success_score": {
        "maximum": 1,
        "minimum": 0,
        "title": "Success Score",
        "type": "number"
      },
      "demonstrated": {
        "items": {
          "$ref": "#/$defs/Demonstration"
        },
        "maxItems": 20,
        "title": "Demonstrated",
        "type": "array"
      },
      "gaps": {
        "items": {
          "$ref": "#/$defs/Gap"
        },
        "maxItems": 20,
        "title": "Gaps",
        "type": "array"
      },
      "next_target": {
        "$ref": "#/$defs/NextTarget"
      },
      "word_evidence": {
        "items": {
          "$ref": "#/$defs/WordEvidence"
        },
        "maxItems": 50,
        "title": "Word Evidence",
        "type": "array"
      }
    },
    "required": [
      "mission_id",
      "recording_id",
      "success_score",
      "demonstrated",
      "gaps",
      "next_target"
    ],
    "title": "ReflectionResult",
    "type": "object"
  },
  "RecordingInput": {
    "additionalProperties": false,
    "properties": {
      "recording_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Recording Id",
        "type": "string"
      },
      "title": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      }
    },
    "required": [
      "recording_id",
      "title"
    ],
    "title": "RecordingInput",
    "type": "object"
  },
  "TranscriptInput": {
    "additionalProperties": false,
    "properties": {
      "recording_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Recording Id",
        "type": "string"
      },
      "transcript": {
        "maxLength": 100000,
        "minLength": 10,
        "title": "Transcript",
        "type": "string"
      }
    },
    "required": [
      "recording_id",
      "transcript"
    ],
    "title": "TranscriptInput",
    "type": "object"
  },
  "LessonProgressInput": {
    "additionalProperties": false,
    "properties": {
      "step": {
        "maximum": 100,
        "minimum": 0,
        "title": "Step",
        "type": "integer"
      }
    },
    "required": [
      "step"
    ],
    "title": "LessonProgressInput",
    "type": "object"
  },
  "LessonCompleteInput": {
    "additionalProperties": false,
    "properties": {
      "score": {
        "maximum": 1,
        "minimum": 0,
        "title": "Score",
        "type": "number"
      }
    },
    "required": [
      "score"
    ],
    "title": "LessonCompleteInput",
    "type": "object"
  }
}
